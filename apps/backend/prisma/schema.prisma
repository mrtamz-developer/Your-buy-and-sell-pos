datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE_WALLET
  POINTS
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(CASHIER)
  store        Store?   @relation(fields: [storeId], references: [id])
  storeId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sales        Sale[]
}

model Store {
  id         String    @id @default(uuid())
  name       String
  address    String?
  products   Product[]
  employees  User[]
  inventories Inventory[]
  sales      Sale[]
  purchases  Purchase[]
  createdAt  DateTime  @default(now())
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  sku         String?  @unique
  price       Int      @default(0) // price in cents
  store       Store?   @relation(fields: [storeId], references: [id])
  storeId     String?
  inventories Inventory[]
  lineItems   SaleLineItem[]
  purchaseLineItems PurchaseLineItem[]
  modifiers   Modifier[]
  variants    Variant[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Variant {
  id        String @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String
  name      String
  sku       String? @unique
  price     Int?    // optional override in cents
}

model Modifier {
  id        String @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String
  name      String
  minSelect Int? @default(0)
  maxSelect Int? @default(1)
  options   ModifierOption[]
}

model ModifierOption {
  id         String @id @default(uuid())
  modifier   Modifier @relation(fields: [modifierId], references: [id])
  modifierId String
  name       String
  priceDelta Int @default(0) // cents to add/subtract
}

model Inventory {
  id        String   @id @default(uuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Int      @default(0)
  store     Store?   @relation(fields: [storeId], references: [id])
  storeId   String?
  updatedAt DateTime @updatedAt
}

model Customer {
  id            String  @id @default(uuid())
  name          String?
  phone         String?
  email         String?
  loyaltyPoints Int     @default(0)
  pointsBalance Int     @default(0)
  sales         Sale[]
  createdAt     DateTime @default(now())
}

model Sale {
  id         String          @id @default(uuid())
  store      Store?          @relation(fields: [storeId], references: [id])
  storeId    String?
  employee   User?           @relation(fields: [employeeId], references: [id])
  employeeId String?
  customer   Customer?       @relation(fields: [customerId], references: [id])
  customerId String?
  total      Int
  createdAt  DateTime        @default(now())
  lineItems  SaleLineItem[]
  payments   Payment[]
  discounts  Discount[]
}

model SaleLineItem {
  id        String  @id @default(uuid())
  sale      Sale    @relation(fields: [saleId], references: [id])
  saleId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int     @default(1)
  unitPrice Int
  // store selected modifiers/options as JSON for reference
  modifiers Json?
}

model Discount {
  id        String @id @default(uuid())
  sale      Sale?  @relation(fields: [saleId], references: [id])
  saleId    String?
  name      String
  type      String // 'PERCENT' | 'FIXED'
  value     Int    // for percent store 10000 = 100.00% or for fixed cents
}

model Payment {
  id               String        @id @default(uuid())
  sale             Sale          @relation(fields: [saleId], references: [id])
  saleId           String
  amount           Int
  method           PaymentMethod
  status           PaymentStatus @default(COMPLETED)
  externalReference String?
  createdAt        DateTime      @default(now())
}

model Purchase {
  id         String                @id @default(uuid())
  store      Store?                @relation(fields: [storeId], references: [id])
  storeId    String?
  supplier   String?
  total      Int
  createdAt  DateTime              @default(now())
  lineItems  PurchaseLineItem[]
}

model PurchaseLineItem {
  id         String   @id @default(uuid())
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  purchaseId String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int
  unitPrice  Int
}

model Refund {
  id         String   @id @default(uuid())
  sale       Sale     @relation(fields: [saleId], references: [id])
  saleId     String
  amount     Int
  createdAt  DateTime @default(now())
  reason     String?
}

model PointsLedger {
  id           String   @id @default(uuid())
  customer     Customer @relation(fields: [customerId], references: [id])
  customerId   String
  change        Int
  reason        String
  balanceAfter  Int
  meta          Json?
  createdAt     DateTime @default(now())
}
