# Environment variables for backend
# Copy to .env and edit values for local development

# Postgres connection string, example:
# postgresql://postgres:postgres@localhost:5432/pos_db?schema=public
DATABASE_URL=

# JWT secret used to sign tokens
JWT_SECRET=

# Points configuration
# 1 point earned per POINTS_EARN_DIVISOR cents spent (default 100)
POINTS_EARN_DIVISOR=100
# Redemption rate: how many cents equals 1 point (default 1 cent per point)
POINTS_REDEMPTION_RATE=1
